{
  "name": "effecti/erp-contracts-slim",
  "description": "Desafio tecnico ERP contratos com Slim 4 e PostgreSQL",
  "type": "project",
  "require": {
    "php": "^8.4",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "vlucas/phpdotenv": "^5.6",
    "robmorgan/phinx": "^0.16"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "phinx migrate -c phinx.php",
    "seed": "phinx seed:run -c phinx.php"
  }
}
